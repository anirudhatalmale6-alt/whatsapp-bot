# WhatsApp Cloud API
WA_PHONE_NUMBER_ID=your_phone_number_id
WA_BUSINESS_ACCOUNT_ID=your_business_account_id
WA_ACCESS_TOKEN=your_permanent_access_token
WA_VERIFY_TOKEN=msouwout_webhook_2026

# The number the bot tells customers to contact (NOT the number it runs on)
WA_CONTACT_NUMBER=+509 4685 9702

# waitlist | live
MSOUWOUT_LAUNCH_MODE=waitlist

# Anthropic (Claude AI)
ANTHROPIC_API_KEY=your_anthropic_api_key
# Optional: pin/upgrade the model. Defaults to the one this was tested against.
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Server
PORT=3200
NODE_ENV=production

# Admin dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password
